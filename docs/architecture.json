  "cards": [
    {
      "dot": "cyan",
      "title": "Trigger & Ingestion",
      "items": [
        "15分ごとの時間主導トリガーで checkFeeds() が自動実行",
        "UrlFetchApp で複数の RSS 2.0 / Atom 1.0 フィードを取得",
        "XmlService で XML を構文解析し記事タイトル・リンク・日時を抽出"
      ]
    },
    {
      "dot": "emerald",
      "title": "State & Rate Limiting",
      "items": [
        "Script Properties で各フィードの最終通知日時 (lastSeen) を永続管理",
        "1回の実行あたり最大5件 (MAX_NOTIFICATIONS_PER_RUN) に通知を制限",
        "Discord は 1 秒間隔、LINE は 429 レート制限リトライ・自動チャンク分割"
      ]
    },
    {
      "dot": "rose",
      "title": "Multi-Platform Dispatch",
      "items": [
        "Discord Webhook によるリッチ Embed 通知（個別 ON/OFF 可能）",
        "LINE Messaging API による Push メッセージ配信（グループ対応）",
        "両方への同時通知、または片方のみの利用に柔軟対応"
      ]
    }
  ]
