  "cards": [
    {
      "dot": "cyan",
      "title": "Trigger & Ingestion",
      "items": [
        "Time-driven cron executes checkFeeds() every 15 minutes",
        "UrlFetchApp retrieves RSS 2.0 and Atom 1.0 XML feeds",
        "XmlService parses items to extract titles, URLs, and dates"
      ]
    },
    {
      "dot": "emerald",
      "title": "State & Rate Limiting",
      "items": [
        "Script Properties keeps seen item IDs per feed",
        "Throttles delivery to max 5 items per execution",
        "LINE 429 retry with 1s pacing between pushes"
      ]
    },
    {
      "dot": "rose",
      "title": "LINE Dispatch",
      "items": [
        "LINE Messaging API pushes to a user or group",
        "Splits long text and batches up to 5 messages per push",
        "Marks only delivered items as seen, so failures retry"
      ]
    }
  ]
